Priority = 96
AutoAdvance = "node_006"
Conditions = Array[ExtResource("3")]([SubResource("cond_14")])

[sub_resource type="Resource" id="cond_16"]
script = ExtResource("3")
QuestId = "pete_herbs_quest"
Status = "Not_Started"

[sub_resource type="Resource" id="node_15"]

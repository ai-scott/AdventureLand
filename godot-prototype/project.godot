; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AdventureLandPrototype"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.6", "C#")

[autoload]

MobileBoot="*res://scripts/systems/MobileBoot.cs"
SaveManager="*res://scripts/systems/SaveManager.cs"
Inventory="*res://scripts/systems/Inventory.cs"
WorldManager="*res://scripts/systems/WorldManager.cs"
FadeOverlay="*res://scenes/ui/FadeOverlay.tscn"
HUD="*res://scenes/ui/HUD.tscn"
InventoryUI="*res://scenes/ui/InventoryUI.tscn"
InteractHintManager="*res://scripts/systems/InteractHintManager.cs"
SFXController="*res://scripts/systems/audio/SFXController.cs"
MusicController="*res://scripts/systems/audio/MusicController.cs"
VOController="*res://scripts/systems/audio/VOController.cs"
EnemyMusicDriver="*res://scripts/systems/audio/EnemyMusicDriver.cs"

[display]

window/size/viewport_width=840
window/size/viewport_height=480
window/size/window_width_override=1680
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="AdventureLandPrototype"

[editor_plugins]

enabled=PackedStringArray("res://addons/msca/plugin.cfg")

[gui]

theme/custom="res://assets/fonts/UiTheme.tres"


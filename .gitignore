# Godot 4 gitignore
.godot/
*.translation
*.import
*.uid

# Exception: font .import files carry pixel-rendering settings (antialiasing,
# hinting, subpixel, oversampling) that must propagate across checkouts —
# without them, fresh clones re-import TTFs with defaults and all pixel
# fonts render blurry. Track the .import alongside the .ttf.
!assets/fonts/*.import

# Exception: music .ogg.import files carry loop=true. Without these,
# fresh clones re-import the music tracks with loop=false (Godot's
# default for audio) and tracks fade out mid-session. SFX and VO are
# one-shots, so they're fine to re-import with defaults.
!assets/audio/music/*.ogg.import

# Exception: map_data .csv.import files carry importer="keep". Without
# them, Godot re-imports the CSVs as Translation resources, which
# claims the .csv path at the resource layer and breaks
# FileAccess.file_exists() in the web export — MapLoader can no longer
# read the raw CSV. Track the .import alongside the .csv.
!assets/map_data/*.csv.import

# itch.io upload artifacts -- the zipped exports/ payload. Build by
# hand or via butler push; never source-controlled.
adventureland-web-*.zip

# Mono/C#
.mono/
data_*/
mono_crash.*.json

# .NET
bin/
obj/

# OS
.DS_Store
Thumbs.db

# TMX backups produced by tools/strip_tmx_crosses.py — first-run safety
# net for the user's Tiled work. Recreated on demand, never edited.
*.tmx.bak

# Claude artifacts
.claude/

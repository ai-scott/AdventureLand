# Godot 4 gitignore
.godot/
*.translation

# .import and .uid files ARE tracked (Godot 4.4+ recommendation). They
# carry the stable resource UIDs that scenes reference, plus import
# settings that must match across checkouts -- e.g. pixel-font hinting
# (assets/fonts), loop=true on music .ogg files, and importer="keep" on
# assets/map_data CSVs (without it, Godot imports them as translations
# and MapLoader can't read them in the web export). Untracked, every
# fresh clone regenerated new UIDs and broke references ("invalid UID"
# warnings).

# itch.io upload artifacts -- the zipped exports/ payload. Build by
# hand or via butler push; never source-controlled.
adventureland-web-*.zip

# Web export output (regenerated by Project -> Export). Kept locally for
# itch uploads; exports/.gdignore keeps Godot from importing it.
exports/

# OS
.DS_Store
Thumbs.db

# TMX backups produced by tools/strip_tmx_crosses.py — first-run safety
# net for the user's Tiled work. Recreated on demand, never edited.
*.tmx.bak

# Claude artifacts
.claude/

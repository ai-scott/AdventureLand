							"parameters": {
								"variable": "baseUID",
								"value": "En_Bat_Base.UID"
							}
						},
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const enemyAI = globalThis.AdventureLand?.EnemyAI;",
								"      const batTerritory = globalThis.AdventureLand?.BatTerritoryManager;",
								"",
								"      if (enemyAI && batTerritory && enemyAI.isInvulnerable(localVars.batUID)) {",
								"        const enemyData = enemyAI.getAllEnemies()[localVars.batUID];",
								"",
								"        if (enemyData && !enemyData.batTargetTreeX) {",
								"          const batInstance = runtime.objects.En_Bat_Base.getInstanceByUid(localVars.batUID);",
								"",
								"          if (batInstance) {",
								"            const nearestTree = batTerritory.findNearestUnoccupiedTree(",
								"              localVars.batUID,",
								"              batInstance.x,",
								"              batInstance.y",
								"            );",
								"",
								"            if (nearestTree) {",
								"              enemyData.batTargetTreeX = nearestTree.x;",
								"              enemyData.batTargetTreeY = nearestTree.y;",
								"              console.log(`🎯 Bat ${enemyData.batId} fleeing to tree at (${nearestTree.x.toFixed(1)}, ${nearestTree.y.toFixed(1)})`);",
								"            }",
								"          }",
								"        }",
								"      }"
							]
						}
					],
					"sid": 976921959942704
				}
			],

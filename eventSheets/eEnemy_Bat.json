							"conditions": [
								{
									"id": "for-each",
									"objectClass": "System",
									"sid": 190617047734270,
									"parameters": {
										"object": "En_Shadow"
									}
								},
								{
									"id": "compare-instance-variable",
									"objectClass": "En_Shadow",
									"sid": 176405035279907,
									"parameters": {
										"instance-variable": "ParentEnemyUID",
										"comparison": 4,
										"value": "0"
									}
								}
							],
							"actions": [
								{
									"type": "script",
									"language": "javascript",
									"script": [
										"const batShadow = globalThis.AdventureLand?.BatShadowManager;",
										"const shadow = runtime.objects.En_Shadow.getFirstPickedInstance();",
										"",
										"if (batShadow && shadow && shadow.instVars.ParentEnemyUID > 0) {",
										"    const shadowPos = batShadow.updateShadow(shadow.instVars.ParentEnemyUID);",
										"    if (shadowPos) {",
										"        shadow.x = shadowPos.x;",
										"        shadow.y = shadowPos.y;",
										"    }",
										"}"
									]
								}
							],
							"sid": 862247412810378
						},
						{
							"eventType": "comment",
							"text": "Z-Order Logic"
						},
						{
							"eventType": "block",
							"conditions": [
								{
									"id": "for-each",
									"objectClass": "System",
									"sid": 992907004824132,
									"parameters": {
										"object": "En_Bat_Base"
									}
								}
							],
							"actions": [
								{
									"type": "script",
									"language": "javascript",
									"script": [
										"// Get picked bat mask (corresponding to this bat base)",
										"const batMask = runtime.objects.EnemyMasks.getFirstPickedInstance();",
										"const shadowManager = globalThis.AdventureLand?.BatShadowManager;",
										"",
										"if (batMask && shadowManager) {",
										"  // Get shadow data for this specific bat",
										"  const allShadows = shadowManager.getAllShadows();",
										"  const shadowData = allShadows.find(s => s.batBaseUID === localVars.batBaseUID);",
										"  ",
										"  if (shadowData) {",
										"    // Map offset 15-80px to Z elevation 10 to -10",
										"    // Low (15px) = above player (10)",
										"    // High (80px) = below player (-10)",
										"    const t = (shadowData.offsetY - 15) / (80 - 15); // 0.0 to 1.0",
										"    batMask.zElevation = 10 - (t * 20); // 10 to -10",
										"  }",
										"}"
									]
								}
							],
							"sid": 376714736496341
						}
					]
				}
			],
			"sid": 639248658559017
		},

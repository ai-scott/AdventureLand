		{
			"eventType": "group",
			"disabled": false,
			"title": "🦇 Bat Initialization",
			"description": "",
			"isActiveOnStart": true,
			"children": [
				{
					"functionName": "InitializeBat",
					"functionDescription": "",
					"functionCategory": "",
					"functionReturnType": "none",
					"functionCopyPicked": false,
					"functionIsAsync": false,
					"functionParameters": [
						{
							"name": "batBaseUID",
							"type": "number",
							"initialValue": "0",
							"comment": "",
							"sid": 876320207657110
						},
						{
							"name": "maskUID",
							"type": "number",
							"initialValue": "0",
							"comment": "",
							"sid": 738010719885961
						},
						{
							"name": "shadowUID",
							"type": "number",
							"initialValue": "0",
							"comment": "",
							"sid": 334475146859393
						}
					],
					"eventType": "function-block",
					"conditions": [],
					"actions": [
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const enemyAI = globalThis.AdventureLand?.EnemyAI;",
								"const batTerritory = globalThis.AdventureLand?.BatTerritoryManager;",
								"const batShadow = globalThis.AdventureLand?.BatShadowManager;",
								"",
								"if (enemyAI && batTerritory && batShadow) {",
								"    // Use localVars with the exact parameter names from the function definition",
								"    const registration = batTerritory.registerBat(localVars.batBaseUID);",
								"",
								"    if (registration) {",
								"    enemyAI.init(localVars.batBaseUID, localVars.maskUID, \"Bat\");",
								"    batShadow.registerShadow(localVars.batBaseUID, localVars.shadowUID);",
								"",
								"    const batInstance = runtime.getInstanceByUid(localVars.batBaseUID);",
								"    const maskInstance = runtime.getInstanceByUid(localVars.maskUID);",
								"    const shadowInstance = runtime.getInstanceByUid(localVars.shadowUID);",
								"",
								"    if (batInstance) {",
								"    batInstance.x = registration.startingTreePos.x;",
								"    batInstance.y = registration.startingTreePos.y;",
								"    batInstance.instVars.BatId = registration.batId;",
								"    batInstance.instVars.Pair_ID = localVars.maskUID;",
								"    }",
								"",
								"    if (maskInstance) {",
								"    maskInstance.x = registration.startingTreePos.x;",
								"    maskInstance.y = registration.startingTreePos.y;",
								"    }",
								"",
								"    if (shadowInstance) {",
								"    shadowInstance.x = registration.startingTreePos.x;",
								"    shadowInstance.y = registration.startingTreePos.y - 4;  // Shadow offset",
								"    shadowInstance.instVars.ParentEnemyUID = localVars.batBaseUID;",
								"    }",
								"",
								"    console.log(`🦇 Bat ${registration.batId} initialized at tree (${registration.startingTreePos.x.toFixed(1)}, ${registration.startingTreePos.y.toFixed(1)})`);",
								"    } else {",
								"    console.warn(\"⚠️ Bat registration failed - max 3 bats allowed\");",
								"    }",
								"} else {",
								"    console.error(\"❌ Bat systems not initialized!\");",
								"}"
							]
						}
					],
					"sid": 929886139272807
				},

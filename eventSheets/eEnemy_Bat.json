								"value": "En_Shadow.ParentEnemyUID"
							}
						},
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"const batShadow = globalThis.AdventureLand?.BatShadowManager;",
								"      if (batShadow) {",
								"        const position = batShadow.updateShadow(localVars.parentUID);",
								"",
								"        if (position) {",
								"          // Find the shadow instance for this parent",
								"          const shadowInstance = runtime.objects.En_Shadow.getAllInstances()",
								"            .find(s => s.instVars.ParentEnemyUID === localVars.parentUID);",
								"          ",
								"          if (shadowInstance) {",
								"            shadowInstance.x = position.x;",
								"            shadowInstance.y = position.y;",
								"          }",
								"        }",
								"      }"
							]
						}
					],
					"sid": 608654198467640
				}

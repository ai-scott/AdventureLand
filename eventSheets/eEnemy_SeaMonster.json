			"actions": [
				{
					"type": "comment",
					"text": "FIRE!"
				},
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"     const smBase = runtime.objects.En_Sea_Monster_Base.getFirstInstance();",
						"      const player = runtime.objects.Player_Base.getFirstInstance();",
						"      ",
						"      if (smBase && player) {",
						"        const spawnX = 505;",
						"        const spawnY = 190;",
						"        ",
						"        const waterBall = runtime.objects.Projectile_WaterBall.createInstance(",
						"          \"Sea Monster\",",
						"          spawnX,",
						"          spawnY",
						"        );",
						"        ",
						"        // Calculate direction vector (THIS WAS WORKING!)",
						"        const dx = player.x - spawnX;",
						"        const dy = player.y - spawnY;",
						"        const distance = Math.sqrt(dx * dx + dy * dy);",
						"        ",
						"        // Normalize and scale by speed",
						"        const speed = 150;",
						"        const vx = (dx / distance) * speed;",
						"        const vy = (dy / distance) * speed;",
						"        ",
						"        // Calculate angle",
						"        const angle = Math.atan2(dy, dx) * (180 / Math.PI);",
						"        waterBall.angleDegrees = angle;",
						"        ",
						"        // Set bullet using velocity components",
						"        const bullet = waterBall.behaviors.Bullet;",
						"        bullet.speed = speed;",
						"        bullet.angleOfMotion = Math.atan2(vy, vx) * (180 / Math.PI);",
						"        ",
						"        waterBall.setAnimation(\"flying\");",
						"        ",
						"        console.log(\"💧 Fired at player\");",
						"      }"
					]
				}
			],

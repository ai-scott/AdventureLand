								{
									"type": "script",
									"language": "javascript",
									"script": [
										"const enemyAI = runtime.imports.AdventureLand.EnemyAI;",
										"const maskInstance = runtime.objects.EnemyMasks.getFirstPickedInstance();",
										"",
										"if (maskInstance && enemyAI) {",
										"  const enemyBaseUID = maskInstance.instVars.Pair_ID;",
										"  ",
										"  if (!enemyAI.isInvulnerable(enemyBaseUID)) {",
										"    console.log(`🔍 COLLISION DETECTED! Enemy ${enemyBaseUID} can be damaged`);",
										"    runtime.callFunction(\"Enemy_Hurt\", maskInstance.uid);",
										"  } else {",
										"    console.log(`🛡️ Enemy ${enemyBaseUID} is invulnerable - blocking damage`);",
										"  }",
										"}"
									]
								}

								{
									"type": "script",
									"language": "javascript",
									"script": [
										"const enemyAI = runtime.imports.AdventureLand.EnemyAI;",
										"const maskInstance = runtime.getInstanceByUid(localVars.maskUid);",
										"",
										"if (maskInstance && enemyAI) {",
										"  const baseUID = maskInstance.instVars.Pair_ID;",
										"  const baseInstance = runtime.getInstanceByUid(baseUID);",
										"  ",
										"  if (baseInstance) {",
										"    // Get enemy type from object name (simpler than TypeScript lookup)",
										"    const objectName = baseInstance.objectType.name;  // \"En_Bat_Base\", \"En_Ooze_Base\", etc.",
										"    const enemyType = objectName.includes(\"Bat\") ? \"Bat\" :",
										"                      objectName.includes(\"Ooze\") ? \"Ooze\" :",
										"                      objectName.includes(\"Crab\") ? \"Crab\" : \"Unknown\";",
										"    ",
										"    console.log(`💀 Enemy ${baseUID} (${enemyType}) defeated!`);",
										"    ",
										"    // Cleanup TypeScript",
										"    enemyAI.notifyDeath(baseUID);",
										"    ",
										"    // Enemy-specific cleanup",
										"    if (enemyType === \"Bat\") {",
										"      const batTerritory = runtime.imports.AdventureLand.BatTerritoryManager;",
										"      const batShadow = runtime.imports.AdventureLand.BatShadowManager;",
										"      if (batTerritory) batTerritory.unregisterBat(baseUID);",
										"      if (batShadow) batShadow.unregisterShadow(baseUID);",
										"    }",
										"    ",
										"    // Destroy the base sprite",
										"    baseInstance.destroy();",
										"  }",
										"}"
									]
								}
							],

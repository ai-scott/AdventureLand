											"script": [
												"const enemyAI = runtime.imports.AdventureLand.EnemyAI;",
												"const maskInstance = runtime.getInstanceByUid(localVars.maskUid);",
												"",
												"if (maskInstance && enemyAI) {",
												"    const baseUID = maskInstance.instVars.Pair_ID;  // Get base from mask",
												"    ",
												"    // Set Hurt to False on the base",
												"    const baseInstance = runtime.getInstanceByUid(baseUID);",
												"    if (baseInstance) {",

													"objectClass": "EnemyBases",
													"sid": 359346755492046,
													"parameters": {
														"instance-variable": "Pair_ID",
														"comparison": 0,
														"value": "EnemyMasks.UID"
													}
												}
											],
											"actions": [
												{
													"id": "set-boolean-instvar",
													"objectClass": "EnemyBases",
													"sid": 587315269468898,
													"parameters": {
														"instance-variable": "Hurt",
														"value": "true"
													}
												},
												{
													"type": "script",
													"language": "javascript",
													"script": [
														"const enemyAI = runtime.imports.AdventureLand.EnemyAI;",
														"const maskInstance = runtime.getInstanceByUid(localVars.enemyUid);",
														"",
														"if (!maskInstance) {",
														"  console.log(`❌ ERROR: Mask instance ${localVars.enemyUid} not found!`);",
														"  return;",
														"}",
														"",
														"if (!enemyAI) {",
														"  console.log(`❌ ERROR: EnemyAI system not available!`);",
														"  return;",
														"}",
														"",
														"const baseUID = maskInstance.instVars.Pair_ID;",
														"",
														"if (!baseUID || baseUID === 0) {",
														"  console.log(`❌ ERROR: Mask ${localVars.enemyUid} has no Pair_ID! Pairing not set up correctly.`);",
														"  return;",
														"}",
														"",
														"console.log(`🔍 Checking enemy ${baseUID} (mask ${localVars.enemyUid})`);",
														"",
														"// CRITICAL: Double-check invulnerability before ANY visual effects",
														"if (enemyAI.isInvulnerable(baseUID)) {",
														"  console.log(`⚠️ Enemy ${baseUID} is invulnerable - blocking all effects`);",
														"  return;",
														"}",
														"",
														"// Proceed with hurt effects...",
														"console.log(`ENEMY HURT!`);",
														"",
														"const enemyBase = runtime.getInstanceByUid(baseUID);",
														"const playerBase = runtime.objects.Player_Base.getFirstInstance();",
														"",
														"if (enemyBase && playerBase) {",
														"  const knockbackX = enemyBase.x - playerBase.x;",
														"  const knockbackY = enemyBase.y - playerBase.y;",
														"  ",
														"  enemyAI.notifyHurt(baseUID, knockbackX, knockbackY);",
														"  console.log(`🗡️ Enemy ${baseUID} hit! Calling notifyHurt`);",
														"} else {",
														"  console.log(`❌ ERROR: Could not find enemyBase (${baseUID}) or playerBase`);",
														"}"
													]
												}
											],

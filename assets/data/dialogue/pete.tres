[sub_resource type="Resource" id="node_7"]
script = ExtResource("2")
id = "node_002"
text = "I've been feeling pretty sick lately. Usually I get herbs from the mountains to the south, but the bridge broke!"
speaker = "Pete"
priority = 99
auto_advance = "node_006"
conditions = Array[ExtResource("3")]([SubResource("cond_8")])

[sub_resource type="Resource" id="cond_12"]
script = ExtResource("3")
quest_id = "pete_herbs_quest"
status = "Not_Started"

[sub_resource type="Resource" id="node_11"]
script = ExtResource("2")
id = "node_003"
text = "Oh, I pan for gold in the rivers and streams. Been pretty lucky over the years."
speaker = "Pete"
priority = 97
auto_advance = "node_005"
conditions = Array[ExtResource("3")]([SubResource("cond_12")])

[sub_resource type="Resource" id="cond_14"]

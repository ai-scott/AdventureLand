[sub_resource type="Resource" id="node_005"]
script = ExtResource("2")
id = "node_005"
text = "Okay, okay! My brother Bill is missing and I'm very upset."
speaker = "Windmill_Nick"
priority = 95
auto_advance = "node_006"
conditions = Array[ExtResource("3")]([SubResource("cond_not_asked")])

[sub_resource type="Resource" id="node_006"]
script = ExtResource("2")
id = "node_006"
text = "I last saw him at the Shrine to the East of the Village."
speaker = "Windmill_Nick"
priority = 94
auto_advance = "node_007"
conditions = Array[ExtResource("3")]([SubResource("cond_not_asked")])

[sub_resource type="Resource" id="resp_21"]

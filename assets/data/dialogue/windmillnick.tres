[sub_resource type="Resource" id="node_002"]
script = ExtResource("2")
id = "node_002"
text = "My brother Bill is lost and I'm trying to find him."
speaker = "Windmill_Nick"
priority = 98
auto_advance = "node_006"
conditions = Array[ExtResource("3")]([SubResource("cond_not_asked")])

[sub_resource type="Resource" id="node_003"]

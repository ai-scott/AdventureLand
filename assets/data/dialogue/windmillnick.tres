[sub_resource type="Resource" id="node_home"]
script = ExtResource("2")
id = "node_home"
text = "BILL! You're home! I... I don't know how to thank you. You found my brother and brought him back safe."
speaker = "Windmill_Nick"
priority = 110
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_returning")])
actions = Array[ExtResource("4")]([SubResource("act_complete")])

[sub_resource type="Resource" id="node_done"]
script = ExtResource("2")
id = "node_done"
text = "Bill's home and safe, all thanks to you. I can't thank you enough."
speaker = "Windmill_Nick"
priority = 109
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_complete")])


[sub_resource type="Resource" id="node_21"]
script = ExtResource("2")
Id = "node_waiting"
Text = "Is it safe to leave yet? That sea monster still scares me!"
Speaker = "Bill"
Priority = 80
EndsDialogue = true
Conditions = Array[ExtResource("3")]([SubResource("cond_22"), SubResource("cond_23")])


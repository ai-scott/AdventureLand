[sub_resource type="Resource" id="node_000"]
script = ExtResource("2")
id = "node_000"
text = "Wh-who's there?! Oh, you're not the sea monster... Thank goodness!"
speaker = "Bill"
priority = 100
auto_advance = "node_001"
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])

[sub_resource type="Resource" id="node_001"]
script = ExtResource("2")
id = "node_001"
text = "I'm Bill. I live at the windmill with my brother Nick. I came down here looking for treasure and... well, things went sideways."
speaker = "Bill"
priority = 99
auto_advance = "node_002"
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])

[sub_resource type="Resource" id="node_002"]
script = ExtResource("2")
id = "node_002"
text = "I found this amazing pink shell on the island, and inside was the Perle du Lac, the most beautiful pearl I've ever seen. So I... took it."
speaker = "Bill"
priority = 98
auto_advance = "node_003"
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])

[sub_resource type="Resource" id="node_003"]
script = ExtResource("2")
id = "node_003"
text = "Then this HUGE sea monster came up out of the water! It was NOT happy. Started spitting water balls at me!"
speaker = "Bill"
priority = 97
auto_advance = "node_004"
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])

[sub_resource type="Resource" id="node_004"]
script = ExtResource("2")
id = "node_004"
text = "I ran and hid in this cave behind the waterfall. I locked the pearl in a chest up above, but... I lost the key while running."
speaker = "Bill"
priority = 96
auto_advance = "node_005"
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])

[sub_resource type="Resource" id="resp_accept"]
script = ExtResource("5")
text = "I'll try to calm the sea monster for you."
leads_to = "node_accept"

[sub_resource type="Resource" id="resp_key"]
script = ExtResource("5")
text = "Do you know where the key went?"
leads_to = "node_key_hint"

[sub_resource type="Resource" id="node_005"]
script = ExtResource("2")
id = "node_005"
text = "I'm too scared to leave. That sea monster is still out there, and this cave is crawling with creatures! Nick must be so worried..."
speaker = "Bill"
priority = 95
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])
responses = Array[ExtResource("5")]([SubResource("resp_accept"), SubResource("resp_key")])

[sub_resource type="Resource" id="resp_key_accept"]
script = ExtResource("5")
text = "I'll deal with the sea monster. Hang tight!"
leads_to = "node_accept"

[sub_resource type="Resource" id="node_key_hint"]
script = ExtResource("2")
id = "node_key_hint"
text = "I think I dropped it near the shrine fountain on the island. But the sea monster is between here and there!"
speaker = "Bill"
priority = 94
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])
responses = Array[ExtResource("5")]([SubResource("resp_key_accept")])

[sub_resource type="Resource" id="act_start"]
script = ExtResource("4")
type = 2
quest_id = "rescue_bill"
status = "Active"

[sub_resource type="Resource" id="node_accept"]
script = ExtResource("2")
id = "node_accept"
text = "You'd really do that? Be careful out there! Calm the sea monster, clear the creatures out of this cave, and I'll head straight home to Nick!"
speaker = "Bill"
priority = 93
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_not_started")])
actions = Array[ExtResource("4")]([SubResource("act_start")])

[sub_resource type="Resource" id="act_returning"]
script = ExtResource("4")
type = 2
quest_id = "rescue_bill"
status = "Bill_Returning"

[sub_resource type="Resource" id="act_left_cave"]
script = ExtResource("4")
type = 6
flag_key = "bill_left_cave"
flag_value = "true"

[sub_resource type="Resource" id="node_leave"]
script = ExtResource("2")
id = "node_leave"
text = "The sea monster's calm AND the cave is clear? You're incredible! I'm heading home to Nick right now!"
speaker = "Bill"
priority = 91
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_active"), SubResource("cond_monster_calm"), SubResource("cond_cave_cleared")])
actions = Array[ExtResource("4")]([SubResource("act_returning"), SubResource("act_left_cave")])

[sub_resource type="Resource" id="node_hint_monster_calm"]
script = ExtResource("2")
id = "node_hint_monster_calm"
text = "You calmed the sea monster?! Amazing... but I still hear things skittering around in here. Clear out those creatures and I'll make a run for it."
speaker = "Bill"
priority = 88
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_active"), SubResource("cond_monster_calm"), SubResource("cond_cave_not_cleared")])

[sub_resource type="Resource" id="node_hint_cave_clear"]
script = ExtResource("2")
id = "node_hint_cave_clear"
text = "It's gone quiet in here... did you get rid of those creatures? But that sea monster is still out there waiting for me!"
speaker = "Bill"
priority = 87
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_active"), SubResource("cond_cave_cleared"), SubResource("cond_monster_not_calm")])

[sub_resource type="Resource" id="node_waiting"]
script = ExtResource("2")
id = "node_waiting"
text = "Is it safe to leave yet? That sea monster still scares me... and I keep hearing things move in the dark."
speaker = "Bill"
priority = 80
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_active")])

[sub_resource type="Resource" id="node_home"]
script = ExtResource("2")
id = "node_home"
text = "I'm home safe, thanks to you! Nick won't stop hugging me. Take care out there, friend."
speaker = "Bill"
priority = 75
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_complete")])

[sub_resource type="Resource" id="node_gone"]
script = ExtResource("2")
id = "node_gone"
text = "(Bill has left the cave and gone back to the windmill.)"
speaker = "Bill"
priority = 70
ends_dialogue = true
conditions = Array[ExtResource("3")]([SubResource("cond_returning")])


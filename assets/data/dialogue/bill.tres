[sub_resource type="Resource" id="node_28"]
script = ExtResource("2")
Id = "node_safe_complete"
Text = "You returned the pearl AND calmed the monster? You're amazing! I'm going home to Nick right now!"
Speaker = "Bill"
Priority = 91
EndsDialogue = true

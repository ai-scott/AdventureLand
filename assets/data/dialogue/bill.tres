[sub_resource type="Resource" id="node_24"]
script = ExtResource("2")
Id = "node_safe"
Text = "The sea monster's calmed down? Oh, what a relief! I'm heading back to the windmill right now. Nick's going to be so happy!"
Speaker = "Bill"
Priority = 90
EndsDialogue = true
Conditions = Array[ExtResource("3")]([SubResource("cond_25"), SubResource("cond_26")])

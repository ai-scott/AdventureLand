[sub_resource type="Resource" id="act_disguise_stop"]
script = ExtResource("3")
type = 0
pattern = 4

[sub_resource type="Resource" id="cond_disguise_far"]
script = ExtResource("4")
operator = 1
value = 48.0

[sub_resource type="Resource" id="cond_not_engaged"]
script = ExtResource("4")
type = 6
operator = 4
value = 0.0

[sub_resource type="Resource" id="beh_disguise"]
script = ExtResource("2")
name = "disguise"
duration_min = 0.4
duration_max = 0.8
weight = 5.0
conditions = Array[ExtResource("4")]([SubResource("cond_disguise_far"), SubResource("cond_not_engaged")])
actions = Array[ExtResource("3")]([SubResource("act_disguise_animate"), SubResource("act_disguise_stop")])

